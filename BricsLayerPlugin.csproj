<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BricsLayerPlugin</RootNamespace>
    <AssemblyName>BricsLayerPlugin</AssemblyName>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      BricsCAD .NET API references - nacitane z lokalni slozky lib/
      Build skript (build.ps1) automaticky zkopiruje DLL z instalace BricsCAD.
    -->
    <Reference Include="BrxMgd">
      <HintPath>lib\BrxMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TD_Mgd">
      <HintPath>lib\TD_Mgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TD_MgdBrep">
      <HintPath>lib\TD_MgdBrep.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
