<Window x:Class="BricsLayerPlugin.UI.ClassEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upravit třídu" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30" ResizeMode="NoResize"
        MinWidth="460">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Název:" Foreground="#CCC"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox"
                 Background="#3E3E42" Foreground="White" BorderBrush="#555"
                 Padding="5,3" FontSize="13" CaretBrush="White"/>

        <!-- Color - label -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Barva:" Foreground="#CCC"
                   VerticalAlignment="Top" Margin="0,4,10,0"/>

        <!-- Color - BricsCAD dialog button + quick buttons + custom -->
        <StackPanel Grid.Row="2" Grid.Column="1">
            <!-- Hlavní tlačítko pro BricsCAD nativní dialog -->
            <Button x:Name="OpenColorDialogBtn" Content="Vybrat barvu (BricsCAD)..."
                    Click="OpenColorDialog_Click"
                    Background="#007ACC" Foreground="White" Padding="8,5" Margin="0,0,0,6"
                    Cursor="Hand" FontSize="12" HorizontalAlignment="Left"/>

            <!-- Rychlý výběr ACI -->
            <TextBlock Text="Rychlý výběr ACI:" Foreground="#888" FontSize="10" Margin="0,0,0,3"/>
            <WrapPanel x:Name="ColorButtonPanel" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ACI číslo:" Foreground="#999" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="CustomColorBox" Width="50"
                         Background="#3E3E42" Foreground="White" BorderBrush="#555"
                         Padding="3,2" TextChanged="CustomColorBox_TextChanged" CaretBrush="White"/>
                <Rectangle x:Name="ColorPreview" Width="30" Height="22" Margin="10,0,0,0"
                           Stroke="#555" StrokeThickness="1"/>
                <TextBlock x:Name="ColorIndexLabel" Foreground="#AAA" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Spacer row for color info -->
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,3,0,0">
            <TextBlock x:Name="TrueColorInfo" Foreground="#4EC9B0" FontSize="11" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Linetype -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Typ čáry:" Foreground="#CCC"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="LinetypeCombo"
                  Background="#3E3E42" Foreground="White" BorderBrush="#555" Padding="3,2">
            <ComboBox.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#3E3E42"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
            </ComboBox.Resources>
        </ComboBox>

        <!-- Lineweight -->
        <TextBlock Grid.Row="7" Grid.Column="0" Text="Tloušťka:" Foreground="#CCC"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="LineweightCombo"
                  Background="#3E3E42" Foreground="White" BorderBrush="#555" Padding="3,2">
            <ComboBox.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#3E3E42"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
            </ComboBox.Resources>
        </ComboBox>

        <!-- Transparency -->
        <TextBlock Grid.Row="9" Grid.Column="0" Text="Průhlednost:" Foreground="#CCC"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
            <Slider x:Name="TransparencySlider" Width="200" Minimum="0" Maximum="90"
                    TickFrequency="5" IsSnapToTickEnabled="True"
                    ValueChanged="TransparencySlider_ValueChanged" VerticalAlignment="Center"/>
            <TextBlock x:Name="TransparencyLabel" Foreground="White" Margin="10,0,0,0"
                       VerticalAlignment="Center" FontSize="13" MinWidth="40"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Margin="5" Click="OK_Click" IsDefault="True"
                    Background="#007ACC" Foreground="White" Padding="8,5" FontSize="13"/>
            <Button Content="Zrušit" Width="90" Margin="5" Click="Cancel_Click" IsCancel="True"
                    Background="#3E3E42" Foreground="White" Padding="8,5" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
