<Window x:Class="BricsLayerPlugin.UI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vstup" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30" ResizeMode="NoResize">
    <StackPanel Margin="15" MinWidth="300">
        <TextBlock x:Name="PromptText" Foreground="White" Margin="0,0,0,10"/>
        <TextBox x:Name="InputBox" Padding="5" FontSize="14" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Margin="5" Click="OK_Click" IsDefault="True"
                    Background="#007ACC" Foreground="White" Padding="5,3"/>
            <Button Content="Zrušit" Width="75" Margin="5" Click="Cancel_Click" IsCancel="True"
                    Background="#3E3E42" Foreground="White" Padding="5,3"/>
        </StackPanel>
    </StackPanel>
</Window>
