<UserControl x:Class="BricsLayerPlugin.UI.ClassPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2D2D30" Foreground="White" MinWidth="280">

    <UserControl.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="#CCC"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ActiveIndicator" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4EC9B0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header s aktivní třídou -->
        <StackPanel DockPanel.Dock="Top" Margin="5">
            <TextBlock Text="Třídy (Classes)" Style="{StaticResource HeaderText}"/>
            <StackPanel Orientation="Horizontal" Margin="5,0">
                <TextBlock Text="Aktivní:" Style="{StaticResource LabelText}"/>
                <TextBlock x:Name="ActiveClassText" Text="(žádná)" Style="{StaticResource ActiveIndicator}"/>
            </StackPanel>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5,0">
            <Button Content="+" Style="{StaticResource DarkButton}" Click="AddClass_Click"
                    ToolTip="Nová třída" Width="32"/>
            <Button Content="&#x2715;" Style="{StaticResource DarkButton}" Click="DeleteClass_Click"
                    ToolTip="Smazat třídu" Width="32"/>
            <Button Content="&#x270E;" Style="{StaticResource DarkButton}" Click="EditClass_Click"
                    ToolTip="Upravit vlastnosti" Width="32"/>
            <Button Content="&#x27F3;" Style="{StaticResource DarkButton}" Click="Refresh_Click"
                    ToolTip="Obnovit" Width="32"/>
        </StackPanel>

        <!-- Detail panel -->
        <Border DockPanel.Dock="Bottom" Background="#252526" Margin="5" Padding="8"
                BorderBrush="#444" BorderThickness="1" CornerRadius="3">
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                <TextBlock x:Name="DetailName" FontWeight="Bold" Foreground="White" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Barva:" Style="{StaticResource LabelText}" Width="80"/>
                    <Rectangle x:Name="DetailColorSwatch" Width="20" Height="16" Stroke="#555"/>
                    <TextBlock x:Name="DetailColorText" Style="{StaticResource LabelText}" Margin="5,3"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Typ čáry:" Style="{StaticResource LabelText}" Width="80"/>
                    <TextBlock x:Name="DetailLinetype" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tloušťka:" Style="{StaticResource LabelText}" Width="80"/>
                    <TextBlock x:Name="DetailLineweight" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Průhlednost:" Style="{StaticResource LabelText}" Width="80"/>
                    <TextBlock x:Name="DetailTransparency" Style="{StaticResource LabelText}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Class list -->
        <ListView x:Name="ClassListView"
                  Background="#1E1E1E" Foreground="White"
                  BorderBrush="#444" Margin="5"
                  SelectionChanged="ClassListView_SelectionChanged"
                  MouseDoubleClick="ClassListView_DoubleClick">
            <ListView.View>
                <GridView>
                    <!-- Active indicator column (► button) -->
                    <GridViewColumn Header="" Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="ActivateClass_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Width="24" Height="20" Padding="0"
                                        ToolTip="Nastavit jako aktivní třídu">
                                    <TextBlock Text="&#x25BA;" FontSize="11" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#555"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="#4EC9B0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Viditelnost" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource DarkCombo}"
                                          Loaded="VisibilityCombo_Loaded"
                                          SelectionChanged="VisibilityCombo_SelectionChanged"
                                          Width="68">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#3E3E42"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="On" Foreground="White"/>
                                    <ComboBoxItem Content="Off" Foreground="White"/>
                                    <ComboBoxItem Content="Grayed" Foreground="White"/>
                                </ComboBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Název" Width="120" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Barva" Width="60" DisplayMemberBinding="{Binding ColorDisplay}"/>
                    <GridViewColumn Header="Čára" Width="80" DisplayMemberBinding="{Binding LinetypeName}"/>
                    <GridViewColumn Header="Tl." Width="40" DisplayMemberBinding="{Binding LineweightMm}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
