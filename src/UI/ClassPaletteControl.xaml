<UserControl x:Class="BricsLayerPlugin.UI.ClassPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2D2D30" Foreground="White" MinWidth="280">

    <UserControl.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="#CCC"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Třídy (VW)" Style="{StaticResource HeaderText}"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5,0">
            <Button Content="+" Style="{StaticResource DarkButton}" Click="AddClass_Click"
                    ToolTip="Nová třída" Width="32"/>
            <Button Content="✕" Style="{StaticResource DarkButton}" Click="DeleteClass_Click"
                    ToolTip="Smazat třídu" Width="32"/>
            <Button Content="✎" Style="{StaticResource DarkButton}" Click="EditClass_Click"
                    ToolTip="Upravit třídu" Width="32"/>
            <Button Content="→" Style="{StaticResource DarkButton}" Click="AssignClass_Click"
                    ToolTip="Přiřadit vybraným objektům" Width="32"/>
            <Button Content="⟳" Style="{StaticResource DarkButton}" Click="Refresh_Click"
                    ToolTip="Obnovit" Width="32"/>
        </StackPanel>

        <!-- Detail panel -->
        <Border DockPanel.Dock="Bottom" Background="#252526" Margin="5" Padding="8"
                BorderBrush="#444" BorderThickness="1" CornerRadius="3">
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                <TextBlock x:Name="DetailName" FontWeight="Bold" Foreground="White" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Barva:" Style="{StaticResource LabelText}" Width="70"/>
                    <Rectangle x:Name="DetailColorSwatch" Width="20" Height="16" Stroke="#555"/>
                    <TextBlock x:Name="DetailColorText" Style="{StaticResource LabelText}" Margin="5,3"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Čára:" Style="{StaticResource LabelText}" Width="70"/>
                    <TextBlock x:Name="DetailLinetype" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tloušťka:" Style="{StaticResource LabelText}" Width="70"/>
                    <TextBlock x:Name="DetailLineweight" Style="{StaticResource LabelText}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Class list -->
        <ListView x:Name="ClassListView"
                  Background="#1E1E1E" Foreground="White"
                  BorderBrush="#444" Margin="5"
                  SelectionChanged="ClassListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Název" Width="140" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Barva" Width="50" DisplayMemberBinding="{Binding ColorIndex}"/>
                    <GridViewColumn Header="Čára" Width="90" DisplayMemberBinding="{Binding LinetypeName}"/>
                    <GridViewColumn Header="Tl." Width="45" DisplayMemberBinding="{Binding LineweightMm}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
