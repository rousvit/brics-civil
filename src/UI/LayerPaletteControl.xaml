<UserControl x:Class="BricsLayerPlugin.UI.LayerPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2D2D30" Foreground="White" MinWidth="280">

    <UserControl.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="#CCC"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Vrstvy (VW)" Style="{StaticResource HeaderText}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5,0">
            <Button Content="▲" Style="{StaticResource DarkButton}" Click="MoveUp_Click" ToolTip="Posunout nahoru" Width="32"/>
            <Button Content="▼" Style="{StaticResource DarkButton}" Click="MoveDown_Click" ToolTip="Posunout dolů" Width="32"/>
            <Button Content="+" Style="{StaticResource DarkButton}" Click="AddLayer_Click" ToolTip="Nová vrstva" Width="32"/>
            <Button Content="✕" Style="{StaticResource DarkButton}" Click="DeleteLayer_Click" ToolTip="Smazat vrstvu" Width="32"/>
            <Button Content="⟳" Style="{StaticResource DarkButton}" Click="Refresh_Click" ToolTip="Obnovit" Width="32"/>
            <Button Content="Sync" Style="{StaticResource DarkButton}" Click="SyncOrder_Click" ToolTip="Synchronizovat pořadí"/>
        </StackPanel>

        <!-- Layer list -->
        <ListView x:Name="LayerListView"
                  Background="#1E1E1E" Foreground="White"
                  BorderBrush="#444" Margin="5"
                  SelectionChanged="LayerListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="35" DisplayMemberBinding="{Binding Order}"/>
                    <GridViewColumn Header="Název" Width="120" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Stav" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="StateCb"
                                          SelectedItem="{Binding State}"
                                          Background="#3E3E42" Foreground="White"
                                          SelectionChanged="StateCombo_SelectionChanged"
                                          Width="60">
                                    <ComboBoxItem Content="On"/>
                                    <ComboBoxItem Content="Off"/>
                                    <ComboBoxItem Content="Grayed"/>
                                </ComboBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
